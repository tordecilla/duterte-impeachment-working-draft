        }
      ]
    },
    {
      "id": "P005",
      "kind": "finding",
      "heading": "The prosecution's case",
      "text": "The prosecution argued that grave threats did not require the recipients themselves to feel fear if the accused intended the threatening effect. On redirect, it treated the November 26 statement as a reiteration and characterized the exchange with the unnamed person as a contract.",
      "citations": [
        {
          "segment_id": "S00894",
          "start_seconds": 7269.5,
          "clock": "02:01:09",
          "speaker_name": "Atty. Amando Virgil D. Ligutan"
        },
        {
          "segment_id": "S00912",
          "start_seconds": 7354.5,
          "clock": "02:02:34",
          "speaker_name": "Atty. Amando Virgil D. Ligutan"
        },
        {
          "segment_id": "S01759",
          "start_seconds": 13951.17,
          "clock": "03:52:31",
          "speaker_name": "Atty. Amando Virgil D. Ligutan"
        },
        {
          "segment_id": "S01965",
          "start_seconds": 15345.92,
          "clock": "04:15:45",
          "speaker_name": "Atty. Amando Virgil D. Ligutan"
        }
      ]
    },
    {
      "id": "P006",
      "kind": "finding",
      "heading": "The defense's response",
      "text": "The defense said the remarks were not threats, but a response during a question-and-answer exchange, and were not aimed directly at the three officials. It also objected to the word contract, saying the Vice President had not used that term and that it was counsel's legal conclusion.",
      "citations": [
        {
          "segment_id": "S00914",
          "start_seconds": 7443.5,
          "clock": "02:04:03",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
