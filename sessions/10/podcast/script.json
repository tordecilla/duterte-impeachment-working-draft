    {
      "id": "P009",
      "kind": "finding",
      "heading": "A second investigative limit",
      "text": "Lotoc referred to Facebook comments urging that Malacañang be stormed. He also acknowledged that the comments were not included in the investigation or in the affidavit of investigation.",
      "citations": [
        {
          "segment_id": "S01192",
          "start_seconds": 9221.55,
          "clock": "02:33:41",
          "speaker_name": "Atty. Jeremy C. Lotoc"
        },
        {
