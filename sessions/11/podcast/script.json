    {
      "id": "P009",
      "kind": "finding",
      "heading": "A disputed characterization",
      "text": "The defense objected to attributing the word assassin to the Vice President. The prosecution responded that the Philippine National Police and the Presidential Communications Office had used the term. Before cross-examination, Senator-Judge Alan Peter Cayetano made a manifestation distinguishing the recorded phrase that she had spoken to someone from the prosecution's characterization that she had contracted an assassin. The chair noted that this was a manifestation rather than a question, then recognized respondent's counsel for cross-examination.",
      "citations": [
        {
          "segment_id": "S00457",
          "start_seconds": 5374.5,
          "clock": "01:29:34",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
