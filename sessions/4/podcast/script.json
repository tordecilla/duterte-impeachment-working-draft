          "speaker_name": "Atty. Roderick C. Wamil"
        }
      ]
    },
    {
      "id": "P005",
      "kind": "finding",
      "heading": "The defense challenge",
      "text": "The defense declined to stipulate to all 845 acknowledgment receipts. It disputed their provenance and count, described Wamil's table as an unsigned personal printout, and reserved the right to test the table's accuracy and individual receipts on cross-examination.",
      "citations": [
        {
          "segment_id": "S00116",
          "start_seconds": 4274.38,
          "clock": "01:11:14",
          "speaker_name": "Atty. Lorna Patajo-Kapunan"
        },
        {
          "segment_id": "S00117",
          "start_seconds": 4287.1,
          "clock": "01:11:27",
          "speaker_name": "Sen. Francis “Chiz” Escudero"
        },
        {
          "segment_id": "S00635",
