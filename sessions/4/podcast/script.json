    {
      "id": "P006",
      "kind": "finding",
      "heading": "The court's limits",
      "text": "The court allowed Wamil to testify from a summary under the rule for voluminous records, without settling the defense's accuracy challenges. It separately limited him to explaining his audit evaluation, not offering expert conclusions about confidentiality, regularity, or violations of Republic Act three zero one nine.",
      "citations": [
        {
          "segment_id": "S00624",
          "start_seconds": 12339.72,
          "clock": "03:25:39",
          "speaker_name": "Sen. Francis “Chiz” Escudero"
        },
        {
          "segment_id": "S00763",
          "start_seconds": 14417.54,
          "clock": "04:00:17",
          "speaker_name": "Atty. Michael Wesley Poa"
        },
        {
          "segment_id": "S00766",
          "start_seconds": 14440.75,
          "clock": "04:00:40",
          "speaker_name": "Sen. Francis “Chiz” Escudero"
        }
      ]
    },
    {
      "id": "P007",
      "kind": "finding",
      "heading": "The receipt summary",
      "text": "Wamil's unsigned summary showed one hundred twenty-five point one five million pesos in expenses. He said some receipts were dated in December 2023 and that the total was one hundred fifty thousand pesos above the one hundred twenty-five million pesos shown in the accomplishment report; those figures remained open to defense testing.",
      "citations": [
        {
          "segment_id": "S00684",
          "start_seconds": 12977.5,
          "clock": "03:36:17",
          "speaker_name": "Atty. Roderick C. Wamil"
        },
        {
