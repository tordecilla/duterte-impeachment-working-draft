    {
      "id": "P018",
      "kind": "finding",
      "heading": "Witnesses and evidence",
      "text": "Constantino, a retired LandBank employee and former Shaw Boulevard branch manager, testified about four OVP checks encashed while she was manager.",
      "citations": [
