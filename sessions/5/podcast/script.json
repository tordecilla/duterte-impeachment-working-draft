        }
      ]
    },
    {
      "id": "P015",
      "kind": "finding",
      "heading": "The defense's position",
      "text": "The defense objected that the opening statement went beyond proper evidentiary presentation and raised fair-play concerns about statements heard even if later struck from the record.",
      "citations": [
