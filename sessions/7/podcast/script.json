    {
      "id": "P012",
      "kind": "finding",
      "heading": "The prosecution's position",
      "text": "The prosecution said the task force and related investigation were relevant to Article IV because they addressed what it called a possible broader threat, and it sought to have Matibag explain the task force's work.",
      "citations": [
        {
          "segment_id": "S00044",
          "start_seconds": 1144.89,
          "clock": "00:19:04",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        },
        {
          "segment_id": "S00045",
          "start_seconds": 1217.0,
          "clock": "00:20:17",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        },
        {
          "segment_id": "S00046",
          "start_seconds": 1252.09,
          "clock": "00:20:52",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        }
      ]
    },
    {
      "id": "P013",
      "kind": "finding",
      "heading": "The prosecution's position",
      "text": "The prosecution presented videos of Sebastian Duterte and the Vice President as material it said the task force compared in its inquiry.",
      "citations": [
        {
          "segment_id": "S00197",
          "start_seconds": 2968.79,
          "clock": "00:49:28",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        },
        {
          "segment_id": "S00202",
