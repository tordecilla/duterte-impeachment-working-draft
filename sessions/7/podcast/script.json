        }
      ]
    },
    {
      "id": "P005",
      "kind": "finding",
      "heading": "What happened",
      "text": "Direct examination covered the NBI's ongoing task-force inquiry, videos shown in court, and documents that Matibag said the task force had considered.",
      "citations": [
        {
          "segment_id": "S00201",
          "start_seconds": 3118.88,
          "clock": "00:51:58",
          "speaker_name": "Sebastian “Baste” Z. Duterte"
