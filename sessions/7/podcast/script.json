        },
        {
          "segment_id": "S00214",
          "start_seconds": 3197.79,
          "clock": "00:53:17",
          "speaker_name": "Atty. Melvin Matibag"
        }
      ]
    },
    {
      "id": "P014",
      "kind": "finding",
      "heading": "The prosecution's position",
      "text": "The prosecution argued that the Lascañas document was being used to show what the task force considered, rather than to prove the truth of its contents.",
      "citations": [
        {
          "segment_id": "S00531",
          "start_seconds": 5543.07,
          "clock": "01:32:23",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        },
        {
          "segment_id": "S00546",
          "start_seconds": 5713.01,
          "clock": "01:35:13",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        }
      ]
    },
    {
      "id": "P015",
      "kind": "finding",
      "heading": "The defense's position",
      "text": "The defense made a continuing relevance and due-process objection to the task-force testimony, arguing that the task force and related allegations were outside the impeachment articles.",
      "citations": [
        {
          "segment_id": "S00038",
          "start_seconds": 995.09,
          "clock": "00:16:35",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
          "segment_id": "S00049",
          "start_seconds": 1335.99,
          "clock": "00:22:15",
          "speaker_name": "Sen. Francis \"Chiz\" G. Escudero"
        },
        {
          "segment_id": "S00052",
          "start_seconds": 1450.14,
          "clock": "00:24:10",
          "speaker_name": "Atty. Mark C. Vinluan"
        }
      ]
    },
    {
      "id": "P016",
      "kind": "finding",
      "heading": "The defense's position",
      "text": "The defense challenged Matibag's ability to testify to the contents of the Lascañas statement, arguing he had not executed it and lacked personal knowledge; it also raised authentication and document-copy concerns.",
      "citations": [
        {
          "segment_id": "S00454",
          "start_seconds": 4953.08,
          "clock": "01:22:33",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
          "segment_id": "S00461",
          "start_seconds": 5002.02,
          "clock": "01:23:22",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
          "segment_id": "S00527",
          "start_seconds": 5523.02,
          "clock": "01:32:03",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
          "segment_id": "S00545",
          "start_seconds": 5688.24,
          "clock": "01:34:48",
          "speaker_name": "Atty. Mark C. Vinluan"
        },
        {
          "segment_id": "S00554",
          "start_seconds": 5776.9,
          "clock": "01:36:16",
          "speaker_name": "Atty. Mark C. Vinluan"
        }
      ]
    },
    {
      "id": "P017",
      "kind": "finding",
      "heading": "The defense's position",
      "text": "On cross, the defense emphasized that Matibag became NBI Director after the earlier inquiry and did not personally participate in its subpoenas, interviews, or execution of related affidavits.",
      "citations": [
        {
          "segment_id": "S00765",
          "start_seconds": 10322.81,
          "clock": "02:52:02",
          "speaker_name": "Sen. Francis \"Chiz\" G. Escudero"
