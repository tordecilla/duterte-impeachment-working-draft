    {
      "id": "P003",
      "kind": "finding",
      "heading": "What happened",
      "text": "After quorum and appearances, the prosecution called NBI Director Melvin Matibag as its last witness for Article IV; he was placed under oath.",
      "citations": [
        {
          "segment_id": "S00010",
          "start_seconds": 556.31,
          "clock": "00:09:16",
          "speaker_name": "Sen. Sherwin T. Gatchalian"
        },
        {
