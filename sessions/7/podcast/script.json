    },
    {
      "id": "P018",
      "kind": "finding",
      "heading": "Witnesses and evidence",
      "text": "Matibag testified as NBI Director and described an Administrative Order creating a task force; his account of the earlier investigation was based on NBI records rather than his personal participation.",
      "citations": [
        {
          "segment_id": "S00111",
          "start_seconds": 2047.73,
          "clock": "00:34:07",
          "speaker_name": "Atty. Melvin Matibag"
        },
        {
          "segment_id": "S00119",
          "start_seconds": 2116.04,
          "clock": "00:35:16",
          "speaker_name": "Atty. Melvin Matibag"
        },
        {
          "segment_id": "S00761",
          "start_seconds": 10304.28,
          "clock": "02:51:44",
          "speaker_name": "Atty. Melvin Matibag"
        },
        {
          "segment_id": "S00808",
          "start_seconds": 10512.92,
          "clock": "02:55:12",
          "speaker_name": "Rep. Gerville “Jinky Bitrics” R. Luistro"
        }
      ]
    },
    {
      "id": "P019",
      "kind": "finding",
      "heading": "Witnesses and evidence",
      "text": "Matibag said the task force was still active, had persons of interest, and had not publicly identified a specific alleged contact; he explained that disclosure could compromise the inquiry and informants.",
      "citations": [
        {
          "segment_id": "S00677",
          "start_seconds": 7394.11,
          "clock": "02:03:14",
          "speaker_name": "Atty. Melvin Matibag"
        },
